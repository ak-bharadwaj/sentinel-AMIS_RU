{
  "project_name": "Sentinel DSS IEEE Publication Dominance",
  "version": "2.0.0",
  "timestamp": "2026-08-08T04:28:30Z",
  "backend_spec": {
    "modules": [
      {
        "name": "Dynamic Corridor Clearance Engine",
        "file": "backend/simulation/engine.py",
        "description": "When heavy rescue vehicles (HIGH_WATER_TRUCK or HELICOPTER airlift) traverse rubble-blocked edges in Earthquake scenarios, the edge transitions to cleared_rubble=True, setting standard car traversal cost to 3.0x normal instead of 1e9 impassable obstacle.",
        "functions": ["_update_agent_movement", "step"]
      },
      {
        "name": "Heterogeneous Fleet Allocator",
        "file": "backend/allocation/allocator.py",
        "description": "Helicopters are prioritized for land-isolated population nodes (nodes with zero open ground corridors), while ground trucks and ambulances are allocated to accessible perimeter targets.",
        "functions": ["allocate_rescue_teams", "calculate_ev"]
      },
      {
        "name": "Speed-Adaptive EGL DAP Protocol",
        "file": "backend/execution_governance/dap.py",
        "description": "Crew safety risk sigma scales with effective vehicle speed rather than binary edge blockage, allowing controlled low-speed navigation without triggering false safety vetoes.",
        "functions": ["_compute_sigma", "_check_vetoes"]
      }
    ],
    "api_routes": [
      {
        "endpoint": "/api/simulation/run",
        "method": "POST",
        "request_dto": {"disaster_type": "str", "seed": "int", "num_rescues": "int"},
        "response_dto": {"survivors_saved": "int", "saved_percent": "float", "stalls": "int"}
      },
      {
        "endpoint": "/api/benchmark/sweep",
        "method": "GET",
        "response_dto": {"results": "dict", "p_values": "dict", "effect_sizes": "dict"}
      }
    ]
  },
  "db_schema": {
    "tables": [
