          {"name": "vehicle_stalls", "type": "INTEGER"},
          {"name": "egl_vetoes", "type": "INTEGER"},
          {"name": "timestamp", "type": "TIMESTAMP"}
        ]
      },
      {
        "table_name": "telemetry_logs",
        "columns": [
